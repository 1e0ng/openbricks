+// SPDX-License-Identifier: MIT
+//
+// openbricks GPIO shims — input reads for hard-tick consumers.
+// (Applied to the MicroPython submodule as a build-time patch from
+// native/patches/; see that directory's README.)
+//
+// The hard-tick button sampler (st_button_core in the user C module)
+// needs a GPIO level read from the esp_timer task, and the user C
+// module cannot include ESP-IDF headers. Two tiny wrappers in port
+// land, exported as plain-int symbols. gpio_get_level is a register
+// read — safe from any task at any rate.
+
+#include "driver/gpio.h"
+
+int ob_gpio_input_pullup(int pin) {
+    gpio_config_t cfg = {
+        .pin_bit_mask = 1ULL << pin,
+        .mode = GPIO_MODE_INPUT,
+        .pull_up_en = GPIO_PULLUP_ENABLE,
+        .pull_down_en = GPIO_PULLDOWN_DISABLE,
+        .intr_type = GPIO_INTR_DISABLE,
+    };
+    return (gpio_config(&cfg) == ESP_OK) ? 0 : -1;
+}
+
+int ob_gpio_read(int pin) {
+    return gpio_get_level((gpio_num_t)pin);
+}
