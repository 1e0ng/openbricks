+// SPDX-License-Identifier: MIT
+//
+// openbricks SPI master shim — blocking transactions for hard-tick
+// consumers (the ICM-45686 raw-IMU heading source). (Applied to the
+// MicroPython submodule as a build-time patch from native/patches/;
+// see that directory's README.)
+//
+// The user C module cannot include ESP-IDF headers, so the SPI
+// master driver is wrapped here in port land and exported as plain
+// symbols. One device slot on purpose: the IMU owns the bus.
+// spi_device_polling_transmit busy-waits the CPU — a 13-byte burst
+// at 8 MHz is ~13 us, legal in the esp_timer hard-tick context.
+// Serialization contract: config-time init writes run on the MP
+// task BEFORE the hard-tick consumer is installed; afterwards the
+// hard tick is the only caller.
+
+#include "driver/spi_master.h"
+
+static spi_device_handle_t ob_spi_dev;
+
+int ob_spi_open(int host, int sck, int mosi, int miso, int cs,
+                int hz, int mode) {
+    if (ob_spi_dev != NULL) {
+        return 0;      // idempotent: the single device already open
+    }
+    spi_bus_config_t bus = {
+        .sclk_io_num = sck,
+        .mosi_io_num = mosi,
+        .miso_io_num = miso,
+        .quadwp_io_num = -1,
+        .quadhd_io_num = -1,
+        .max_transfer_sz = 32,
+    };
+    if (spi_bus_initialize(host, &bus, SPI_DMA_DISABLED) != ESP_OK) {
+        return -1;
+    }
+    spi_device_interface_config_t dev = {
+        .clock_speed_hz = hz,
+        .mode = mode,
+        .spics_io_num = cs,
+        .queue_size = 1,
+    };
+    if (spi_bus_add_device(host, &dev, &ob_spi_dev) != ESP_OK) {
+        ob_spi_dev = NULL;
+        return -1;
+    }
+    return 0;
+}
+
+int ob_spi_txn(const uint8_t *tx, uint8_t *rx, int len) {
+    if (ob_spi_dev == NULL) {
+        return -1;
+    }
+    spi_transaction_t t = {
+        .length = (size_t)len * 8,
+        .tx_buffer = tx,
+        .rx_buffer = rx,
+    };
+    return (spi_device_polling_transmit(ob_spi_dev, &t) == ESP_OK)
+           ? 0 : -1;
+}
