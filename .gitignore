# Python
__pycache__/
*.py[cod]
*$py.class
.mypy_cache/
.ruff_cache/
.pytest_cache/
.venv/
venv/
env/

# MicroPython cross-compiled
*.mpy
# ...except the checked-in loader test fixtures (regenerate with
# scripts/gen-mpy-fixtures.py after an mpy-cross pin bump)
!tests/fixtures/*.mpy

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Build artifacts
build/
dist/
*.egg-info/

# Coverage artifacts
.coverage
.coverage.*
htmlcov/
coverage.xml

# Local robot configs (users often keep calibration in here)
robot.local.json
*.so
tools/openbricks/native/_shared/
tools/openbricks/openbricks/
docs/_build/
# _docs/ was generated at build time (guides synced from docs/), so it
# was ignored wholesale. The offline manual bundle is now COMMITTED —
# that is what lets a wheel build work without Sphinx — so ignore the
# directory's CONTENTS and keep the one archive. A directory-level
# ignore cannot be undone by a later negation, hence the /* form.
tools/openbricks/openbricks_dev/_docs/*
!tools/openbricks/openbricks_dev/_docs/offline-docs.zip
